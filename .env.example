# ─── Copy to .env and fill in. Never commit real credentials. ───
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_NAME=CareFlow
# Public URL of the web client (used in secure SMS/WhatsApp links)
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://careflow:careflow_dev@localhost:5434/careflow?schema=public

# 32+ random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=e7DTmWe8EDC9awHrKrF/UnAhmdduDWhVhKIvWpBoqEdEHHSddkLjJJCyzrU0WJ+j
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# ─── Messaging (mock by default — nothing is sent) ───
SMS_PROVIDER=mock            # mock | http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

WHATSAPP_PROVIDER=mock       # mock | cloud_api (official WhatsApp Business Platform only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en

EMAIL_PROVIDER=mock          # mock | http
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.test

# ─── Storage ───
STORAGE_PROVIDER=local       # local | mock | s3 (s3 adapter pending)
STORAGE_LOCAL_DIR=./var/storage
STORAGE_BUCKET=
UPLOAD_MAX_BYTES=10485760
DOWNLOAD_URL_TTL_SECONDS=300
SECURE_LINK_TTL_HOURS=72

# ─── Other integrations (mock only in this release) ───
PAYMENT_PROVIDER=mock
HEALTH_DATA_PROVIDER=mock
TELECONSULT_PROVIDER=mock
FHIR_PROVIDER=mock
ABDM_PROVIDER=mock

NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_WORKER_INTERVAL_MS=15000

# Shows DEMO banners/watermarks. Keep true for any non-production environment.
DEMO_MODE=false
# Test-only helper routes (mock outbox etc.). Refused when NODE_ENV=production.
ENABLE_TEST_ROUTES=false

# Seed-only: password for all demo accounts (local development only)
SEED_DEMO_PASSWORD=Demo@12345
