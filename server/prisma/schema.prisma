// [APP_NAME] — Hospital / Clinic Management Platform
// PostgreSQL + Prisma. All timestamps stored in UTC (timestamptz). Money uses Decimal, never float.
// Additional DB-level safeguards (partial unique index for slot booking, append-only triggers
// for audit + finalized prescription versions) live in prisma/migrations/*_db_safeguards/migration.sql.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

